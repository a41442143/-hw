@model IEnumerable<CompanyStatWeb.Models.CompanyStats>

@{
    ViewData["Title"] = "Company Data";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark">Company Statistics</h2>
            <p class="text-muted mb-0">Monthly financial performance reports</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-corporate">
                <i class="fas fa-plus-circle me-1"></i> Create New
            </a>
        }
    </div>

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3 bg-light rounded">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Search by Month (e.g., 11201)...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">Filter</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-link text-decoration-none">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-corporate table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["MonthSortParm"]" class="text-white text-decoration-none">
                                Month <i class="fas fa-sort ms-1"></i>
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["CountSortParm"]" class="text-white text-decoration-none">
                                Public Companies <i class="fas fa-sort ms-1"></i>
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["CapitalSortParm"]" class="text-white text-decoration-none">
                                Capital (100M) <i class="fas fa-sort ms-1"></i>
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["MarketValueSortParm"]" class="text-white text-decoration-none">
                                Market Value (100M) <i class="fas fa-sort ms-1"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-center" style="width: 150px;">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold text-primary">
                                @Html.DisplayFor(modelItem => item.Month)
                            </td>
                            <td class="text-end">
                                @Html.DisplayFor(modelItem => item.PublicCompanyCount)
                            </td>
                            <td class="text-end text-success fw-bold">
                                @Html.DisplayFor(modelItem => item.PublicCompanyCapital)
                            </td>
                            <td class="text-end text-info fw-bold">
                                @Html.DisplayFor(modelItem => item.PublicCompanyMarketValue)
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Month" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Month" class="btn btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>