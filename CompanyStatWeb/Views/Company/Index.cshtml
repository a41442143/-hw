        <button type="submit" class="btn btn-outline-primary">搜尋</button>
        <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
    </div>
</form>

<div class="d-flex justify-content-between mb-3 align-items-center">
    <div>
        <a asp-action="Create" class="btn btn-primary">新增資料</a>
    </div>
    <div class="btn-group" role="group" aria-label="Sorting">
        <span class="input-group-text bg-white border-0 fw-bold">排序：</span>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["MonthSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-outline-secondary">
            月別 @(ViewData["MonthSortParm"]?.ToString() == "month_desc" ? "↓" : "↑")
        </a>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["CountSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-outline-secondary">
            家數 @(ViewData["CountSortParm"]?.ToString() == "count_desc" ? "↓" : "↑")
        </a>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["CapitalSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-outline-secondary">
            資本額 @(ViewData["CapitalSortParm"]?.ToString() == "capital_desc" ? "↓" : "↑")
        </a>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["MarketValueSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-outline-secondary">
            市值 @(ViewData["MarketValueSortParm"]?.ToString() == "marketValue_desc" ? "↓" : "↑")
