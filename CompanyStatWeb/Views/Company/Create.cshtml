@model CompanyStatWeb.Models.CompanyStats

@{
    ViewData["Title"] = "新增資料";
}

<h1>新增資料</h1>

<h4>公司統計</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Month" class="control-label"></label>
                <input asp-for="Month" class="form-control" placeholder="格式: YYYY-MM" />
                <span asp-validation-for="Month" class="text-danger"></span>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-primary text-white">上市公司</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PublicCompanyCount" class="control-label"></label>
                            <input asp-for="PublicCompanyCount" class="form-control" />
                            <span asp-validation-for="PublicCompanyCount" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PublicCompanyCapital" class="control-label"></label>
                            <input asp-for="PublicCompanyCapital" class="form-control" />
                            <span asp-validation-for="PublicCompanyCapital" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PublicCompanyGrowthRate" class="control-label"></label>
                            <input asp-for="PublicCompanyGrowthRate" class="form-control" />
                            <span asp-validation-for="PublicCompanyGrowthRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PublicCompanyFaceValue" class="control-label"></label>
                            <input asp-for="PublicCompanyFaceValue" class="form-control" />
                            <span asp-validation-for="PublicCompanyFaceValue" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PublicCompanyMarketValue" class="control-label"></label>
                            <input asp-for="PublicCompanyMarketValue" class="form-control" />
                            <span asp-validation-for="PublicCompanyMarketValue" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-success text-white">上櫃公司</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="OtcCompanyCount" class="control-label"></label>
                            <input asp-for="OtcCompanyCount" class="form-control" />
                            <span asp-validation-for="OtcCompanyCount" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OtcCompanyCapital" class="control-label"></label>
                            <input asp-for="OtcCompanyCapital" class="form-control" />
                            <span asp-validation-for="OtcCompanyCapital" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OtcCompanyGrowthRate" class="control-label"></label>
                            <input asp-for="OtcCompanyGrowthRate" class="form-control" />
                            <span asp-validation-for="OtcCompanyGrowthRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="OtcCompanyFaceValue" class="control-label"></label>
                            <input asp-for="OtcCompanyFaceValue" class="form-control" />
                            <span asp-validation-for="OtcCompanyFaceValue" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="OtcCompanyMarketValue" class="control-label"></label>
                            <input asp-for="OtcCompanyMarketValue" class="form-control" />
                            <span asp-validation-for="OtcCompanyMarketValue" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-secondary text-white">未上市櫃公司</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NonPublicCompanyCount" class="control-label"></label>
                            <input asp-for="NonPublicCompanyCount" class="form-control" />
                            <span asp-validation-for="NonPublicCompanyCount" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NonPublicCompanyCapital" class="control-label"></label>
                            <input asp-for="NonPublicCompanyCapital" class="form-control" />
                            <span asp-validation-for="NonPublicCompanyCapital" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
