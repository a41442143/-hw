@model CompanyStatWeb.ViewModels.SiteSettingsViewModel

@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-dark">System Settings</h2>
            <p class="text-muted">Configure global application preferences.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0"><i class="fas fa-sliders-h me-2 text-muted"></i>General Configuration</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Settings" method="post">
                        <div class="mb-3">
                            <label asp-for="SiteName" class="form-label fw-bold">Application Name</label>
                            <input asp-for="SiteName" class="form-control" />
                            <span asp-validation-for="SiteName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactEmail" class="form-label fw-bold">Admin Contact Email</label>
                            <input asp-for="ContactEmail" class="form-control" />
                            <div class="form-text">This email will be displayed on the contact page.</div>
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="ItemsPerPage" class="form-label fw-bold">Default Items Per Page</label>
                                <select asp-for="ItemsPerPage" class="form-select">
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="MaintenanceMode" id="maintenanceSwitch">
                                <label class="form-check-label fw-bold" for="maintenanceSwitch">Enable Maintenance Mode</label>
                            </div>
                            <div class="form-text text-warning"><i class="fas fa-exclamation-triangle me-1"></i> When enabled, only administrators can access the system.</div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary-corporate px-4">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-muted">Information</h6>
                    <p class="small text-muted">Settings changes take effect immediately for new requests. Some configuration might require a restart to apply fully.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
