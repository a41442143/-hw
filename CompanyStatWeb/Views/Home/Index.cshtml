@model CompanyStatWeb.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-dark border-bottom pb-2">Executive Overview</h2>
            <p class="text-muted">Welcome to the CompanyStat Professional Analytics Platform.</p>
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="row">
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #3498db;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Total Reports</h5>
                        <div class="value">@Model.TotalRecords.ToString("N0")</div>
                    </div>
                    <i class="fas fa-file-alt fa-2x text-muted opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #2ecc71;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Total Market Cap</h5>
                        <div class="value">@Model.TotalMarketValue.ToString("N0")</div>
                    </div>
                    <i class="fas fa-chart-pie fa-2x text-muted opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #e74c3c;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Total Capital</h5>
                        <div class="value">@Model.TotalCapital.ToString("N0")</div>
                    </div>
                    <i class="fas fa-coins fa-2x text-muted opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #f39c12;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Avg Companies</h5>
                        <div class="value">@Model.AverageCompanyCount.ToString("N0")</div>
                    </div>
                    <i class="fas fa-building fa-2x text-muted opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Activity -->
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="mb-0">System Status</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <p class="text-muted">The platform is running smoothly. Displaying data up to <strong>@Model.LatestMonth</strong>.</p>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-muted mt-2 d-block">Data Source: Local Database</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
             <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="d-grid gap-2">
                        <a asp-controller="Company" asp-action="Index" class="btn btn-outline-primary"><i class="fas fa-list me-2"></i>View Reports</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Company" asp-action="Create" class="btn btn-outline-success"><i class="fas fa-plus me-2"></i>Add New Data</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
